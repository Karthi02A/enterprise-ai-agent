# Enterprise AI Agent Environment Configuration
# Rename this file to .env and populate your actual API keys

# Groq API Key (Required for LLM synthesis)
GROQ_API_KEY=your_groq_api_key_here

# HuggingFace Token (Optional)
HF_TOKEN=your_huggingface_token_here

# Redis URL (Optional, defaults to local in-memory RAM cache fallback if offline)
REDIS_URL=redis://localhost:6379
